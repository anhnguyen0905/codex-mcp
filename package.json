{
  "name": "@anhnguyen0905/codex-mcp",
  "version": "0.34.0",
  "description": "MCP server bridging Claude Code and OpenAI Codex CLI for plan-execute-review workflows",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhnguyen0905/codex-mcp.git"
  },
  "homepage": "https://github.com/anhnguyen0905/codex-mcp#readme",
  "bugs": {
    "url": "https://github.com/anhnguyen0905/codex-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "coverage": "vitest run --coverage",
    "test:e2e": "node scripts/smoke-e2e.mjs",
    "skills:sync": "node scripts/sync-awesome-skills.mjs --clone",
    "skills:index": "node scripts/build-skills-index.mjs",
    "skills:eval": "node scripts/skill-eval.mjs --report docs/skill-selection-eval-report.md --negatives tests/fixtures/NEGATIVES.md",
    "skills:eval:scope": "node scripts/skill-eval.mjs --scenarios tests/fixtures/scenarios-500.json --negatives tests/fixtures/NEGATIVES.md --min-pass 0.99 --max-avg-selection 5.1 --max-noise 0.80",
    "skills:eval:scope100": "node scripts/skill-eval.mjs --scenarios tests/fixtures/scenarios-100.json --negatives tests/fixtures/NEGATIVES.md --min-pass 0.99 --max-avg-selection 6.7",
    "skills:eval:raw": "node scripts/skill-eval.mjs --scenarios tests/fixtures/scenarios-500.json --negatives tests/fixtures/NEGATIVES.md --raw --min-pass 0.67",
    "skills:eval:vi": "node scripts/skill-eval.mjs --scenarios tests/fixtures/scenarios-vi.json --negatives tests/fixtures/NEGATIVES.md --raw --min-pass 0.67",
    "waves": "node scripts/task-waves.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codex",
    "claude-code",
    "openai-codex",
    "ai-agents",
    "code-review"
  ],
  "author": "anhnguyen0905",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codex-mcp": "dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "scripts/tail-progress.mjs",
    "scripts/doctor.mjs",
    "scripts/startup-probe.mjs",
    "scripts/npm-smoke.mjs",
    "scripts/build-skills-index.mjs",
    "scripts/sync-awesome-skills.mjs",
    "scripts/skill-match.mjs",
    "scripts/skill-terms.mjs",
    "scripts/skill-shortlist.mjs",
    "scripts/skill-tokens.mjs",
    "scripts/skill-eval.mjs",
    "scripts/task-waves.mjs",
    "scripts/jev-client.mjs",
    "scripts/scope-check.mjs",
    "scripts/flow-state.mjs",
    "scripts/flow-state-cli.mjs",
    "scripts/flow-events.mjs",
    "scripts/context-slice.mjs",
    "scripts/decision-log.mjs",
    "scripts/worktree-setup.mjs",
    "scripts/project-context.mjs",
    "scripts/requirements-coverage.mjs",
    "scripts/skill-brief.mjs",
    "scripts/skill-lint.mjs",
    "scripts/session-cost.mjs",
    "scripts/run-ledger.mjs",
    "scripts/profile-router.mjs",
    "scripts/evidence-check.mjs",
    "scripts/debate-parse.mjs",
    "scripts/smoke-e2e.mjs",
    "skills",
    "commands",
    "tests/fixtures/skill-scenarios.json",
    "README.md",
    "LICENSE"
  ]
}
